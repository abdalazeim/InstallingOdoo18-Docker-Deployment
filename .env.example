ODOO_IMAGE=odoo:18
PG_IMAGE=postgres:17
POSTGRES_USER=odoo18
POSTGRES_PASSWORD=odoo@18
POSTGRES_DB=postgre
ODOO_ADMIN_PASSWORD=Admin@18
ODOO_HTTP_PORT=10018
ODOO_CHAT_PORT=20018
ODOO_NETWORK=odoo18_internal
ODOO_CONTAINER_NAME=odoo18
ODOO_DB_CONTAINER_NAME=odoo18-db
ODOO_DATA_VOLUME=odoo18_data

# Used only with docker-compose.traefik.yml
ODOO_DOMAIN=odoo.example.com
DOCKER_PROXY_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
CERTSRESOLVER=letsencrypt
